{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@pages/*": ["src/pages/*"], "@components/*": ["src/components/*"], "@data/*": ["src/data/*"], "@fixtures": ["src/fixtures/index.ts"] }
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
